# ======================================================================
# Voice cascade on Groq: speech to text → LLM (coordinator) → text to speech
# ======================================================================
GROQ_API_KEY=                               # console.groq.com → API Keys
GROQ_LLM_MODEL=openai/gpt-oss-120b          # needs function calling. Faster: llama-3.3-70b-versatile
GROQ_LLM_FALLBACK_MODELS=openai/gpt-oss-20b   # used when the main model is rate limited (comma-separated)
GROQ_REASONING_EFFORT=low                   # gpt-oss only: low | medium | high
LLM_TEMPERATURE=0.7
GROQ_STT_MODEL=whisper-large-v3-turbo       # or whisper-large-v3 (slower, a little more accurate)
STT_LANGUAGE=en
STT_NO_SPEECH_MAX=0.6                       # drop Whisper segments it rates as probably not speech
GROQ_TTS_MODEL=canopylabs/orpheus-v1-english
GROQ_TTS_VOICE=hannah                       # autumn diana hannah | austin daniel troy

# Turn detection (local Silero VAD)
VAD_THRESHOLD=0.5
VAD_MIN_SPEECH_MS=160                       # speech this long starts a customer turn (and barges in)
VAD_SILENCE_MS=500
# While the customer reads out digits, an address or a security answer: wait longer before ending their turn
VAD_SILENCE_MS_LONG_INPUT=1000
# ...and treat transcripts that arrive this close together as one answer
TRANSCRIPT_MERGE_WINDOW_MS=1500
TRANSCRIPT_MERGE_WINDOW_INCOMPLETE_MS=3000   # a partial number/postcode waits this long for the rest; a complete one is checked at once

# true = every customer utterance is checked by guardrails before the model may reply
GUARD_BEFORE_RESPONSE=true

# Conversation timing
POST_ACK_DELAY_MS=1000                 # pause after an acknowledgement/progress line has finished playing
SILENCE_REPROMPT_S=15                  # caller silent after a question: gentle check-in after this long
SILENCE_MAX_REPROMPTS=2                # ...then a polite close (logged as abandoned)
# Demo: close the session after the transfer message has played. Real telephony: false (the transfer takes over)
DEMO_CUT_CALL_ON_TRANSFER=true

# Topic guard (input guardrail, local embedding classifier: keeps the agent on FreshCart customer service)
TOPIC_GUARD_MIN_SCORE=0.36
TOPIC_GUARD_MARGIN=0.10

# ======================================================================
# Azure AI Content Safety (optional input guardrails: Prompt Shields + harm categories)
# ======================================================================
AZURE_CONTENT_SAFETY_ENDPOINT=
AZURE_CONTENT_SAFETY_KEY=                  # empty = Entra ID (scope cognitiveservices)
AZURE_CONTENT_SAFETY_BLOCK_SEVERITY=4      # 0 | 2 | 4 | 6

# ======================================================================
# Service wiring and behaviour
# ======================================================================
MCP_GATEWAY_URL=http://localhost:8200
BACKEND_URL=http://localhost:8100
MCP_TIMEOUT_S=8                        # a tool call slower than this is a system issue (never a wrong answer)
BACKEND_TIMEOUT_S=6                    # MCP gateway → backend systems
GUARDRAIL_TIMEOUT_S=2.0
GUARDRAIL_FAIL_MODE=open                   # open | closed
IDV_MAX_RETRIES=1
PROGRESS_UPDATE_MS=1500
CONTACT_CHANNEL=voice
ORDER_NUMBER_LENGTH=10
LOG_LEVEL=INFO

# Mock backend
MOCK_LATENCY_MS_MIN=120
MOCK_LATENCY_MS_MAX=450
FRAUD_LINE_AVAILABLE=true
